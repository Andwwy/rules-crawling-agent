# Copy to .env and fill in. .env is gitignored.
#
# PERPLEXITY_API_KEY is the only paid key needed for the prototype. One key
# covers all three LLM keypaths: the extractor and the judge (both
# anthropic/claude-haiku-4-5 via Perplexity's Agent API, no markup) and 1024-d
# embeddings (pplx-embed-v1-0.6b). Pre-prod swaps these for the Anthropic SDK
# directly + voyage-3 — see src/config.py and src/embedder.py.
PERPLEXITY_API_KEY=pplx-...

# Optional but recommended — unauthenticated GitHub API is rate-limited to 60 req/hr.
GITHUB_TOKEN=ghp_...

# Optional — when set, the crawler + admin both connect to MotherDuck's cloud
# DB instead of the local /data/rules.duckdb file. Get a service token at
# https://app.motherduck.com → Settings → Service tokens.
MOTHERDUCK_TOKEN=
MOTHERDUCK_DB=rules_in_the_wild
